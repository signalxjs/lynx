<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- {{PERMISSIONS}} -->

    <!-- {{FEATURES}} -->

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SigxApp"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- configChanges: every listed change is handled IN PLACE instead of
             recreating the Activity and reloading the bundle (which would lose
             all app state).
               fontScale         — FontScalePublisher, LynxView.updateFontScale (#766)
               orientation|screenSize
                                 — the rotation pair on modern Android;
                                   ScreenMetricsPublisher re-bases the viewport (#856)
               smallestScreenSize|screenLayout
                                 — foldable unfold and multi-window resize
               keyboardHidden    — docking a hardware keyboard
               uiMode            — dark-mode flips switch IN PLACE (#986):
                                   AppearancePublisher's application-level
                                   ComponentCallbacks2 republishes the scheme
                                   (engine updateColorScheme + appearanceChanged
                                   event) without recreating the Activity or
                                   reloading the bundle -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="fontScale|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="{{orientation}}"
            android:theme="@style/Theme.SigxApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- {{INTENT_FILTERS}} -->
        </activity>

        <!--
            FileProvider — required by @sigx/lynx-camera so the system camera
            intent has a content:// URI to write the captured photo into. The
            authority MUST match `${packageName}.fileprovider` because
            MediaCapture.kt builds it from the application package name.
            Cache-dir-only paths (file_provider_paths.xml) keep the surface
            minimal; modules that need more can extend the paths file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- {{META_DATA}} -->

        <!-- {{APP_META_DATA}} -->

        <!-- {{SERVICES}} -->
    </application>
</manifest>
