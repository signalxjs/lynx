{
    "name": "SigxCore",
    "package": "@sigx/lynx-core",
    "description": "Shared native helpers (Activity holder + presentation + device info) for sigx-lynx modules",
    "platforms": ["android", "ios"],
    "android": {
        "moduleClass": "com.sigx.core.DeviceInfoModule",
        "publisherClass": [
            "com.sigx.core.AppStatePublisher",
            "com.sigx.core.FontScalePublisher",
            "com.sigx.core.ScreenMetricsPublisher"
        ],
        "activityHook": {
            "class": "com.sigx.core.SigxActivityHook",
            "methods": ["onCreate", "onResume", "onPause"]
        },
        "sourceDir": "android"
    },
    "ios": {
        "moduleClass": "DeviceInfoModule",
        "publisherClass": ["AppStatePublisher", "FontScalePublisher", "ScreenMetricsPublisher"],
        "methods": [
            "getDeviceInfo",
            "getAppState",
            "lockOrientation",
            "unlockOrientation"
        ],
        "sourceDir": "ios"
    }
}
